# Alpaca Paper only. Live trading is intentionally not supported.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Additional Paper accounts use a unique prefix referenced by
# credential_env_prefix in config/paper_portfolio.json. Never place keys in
# the JSON file. When more than one account is enabled, also pin every
# expected_broker_account_id to the account UUID returned by Alpaca.
# ALPACA_FUND_B_API_KEY_ID=
# ALPACA_FUND_B_API_SECRET_KEY=
# ALPACA_FUND_B_BASE_URL=https://paper-api.alpaca.markets

# Global switches are combined with the emergency stop and each strategy's
# Paper approval. Leave both false for signal observation. Enabling automation
# alone performs risk-evaluated dry runs without sending orders.
TRADING_AUTOMATION_ENABLED=false
TRADING_ENABLE_PAPER_ORDERS=false
# Immediate global block for new Paper submissions. Existing broker orders
# and positions must still be managed/reconciled at Alpaca.
TRADING_EMERGENCY_STOP=false
TRADING_DB_PATH=var/trading.db
TRADING_HEARTBEAT_SECONDS=30
TRADING_HEALTH_PATH=var/health.json
TRADING_HEALTH_MAX_AGE_SECONDS=120
TRADING_STRATEGY_CYCLE_SECONDS=300
TRADING_STRATEGY_HEALTH_PATH=var/strategy-health.json
TRADING_STRATEGY_HEALTH_MAX_AGE_SECONDS=900
TRADING_PORTFOLIO_CONFIG=config/paper_portfolio.json
TRADING_MARKET_DATA_FEED=iex
# Free indicative quotes are suitable for engineering checks, not execution
# decisions. Use opra only when the Alpaca subscription is active.
TRADING_OPTION_DATA_FEED=indicative
TRADING_MARKET_LOOKBACK_DAYS=10
TRADING_MARKET_MAX_BAR_AGE_SECONDS=900

# Long-horizon evidence model. This is observation-only and cannot create
# orders. It refreshes closed daily bars and stores auditable decisions.
TRADING_RESEARCH_CYCLE_SECONDS=3600
TRADING_RESEARCH_HEALTH_PATH=var/research-health.json
TRADING_RESEARCH_HEALTH_MAX_AGE_SECONDS=10800
TRADING_RESEARCH_PROGRAM=config/research_program.json
TRADING_RESEARCH_LOOKBACK_DAYS=1500

# Intraday Strategy Lab. It is validation-only and has no broker execution
# dependency. Every configured model is retested across the account watchlist
# under base and adverse transaction-cost assumptions.
TRADING_STRATEGY_LAB_CYCLE_SECONDS=21600
TRADING_STRATEGY_LAB_HEALTH_PATH=var/strategy-lab-health.json
TRADING_STRATEGY_LAB_HEALTH_MAX_AGE_SECONDS=64800
TRADING_STRATEGY_LAB_LOOKBACK_DAYS=120
TRADING_STRATEGY_LAB_BASE_COST_BPS=10
TRADING_STRATEGY_LAB_STRESSED_COST_BPS=25
TRADING_STRATEGY_LAB_CHRONOLOGICAL_FOLDS=3
TRADING_STRATEGY_LAB_TRADE_SEQUENCE_PATHS=500
TRADING_STRATEGY_LAB_COMPARISON_VARIANTS=1
TRADING_STRATEGY_EXPERIMENT_PROGRAM=config/strategy_experiments.json

# Research-only Asset Universe. Alpaca supplies tradability and liquidity;
# SEC company facts can supply conservative company-size evidence. The SEC
# requires a declared organization/contact User-Agent, for example:
# MultiTrade Research admin@example.com
TRADING_ASSET_UNIVERSE_CYCLE_SECONDS=86400
TRADING_ASSET_UNIVERSE_HEALTH_PATH=var/asset-universe-health.json
TRADING_ASSET_UNIVERSE_HEALTH_MAX_AGE_SECONDS=259200
TRADING_ASSET_UNIVERSE_CONFIG=config/asset_universe.json
TRADING_SEC_USER_AGENT=

# The dashboard is read-only and published only through the approved Caddy
# HTTPS profile. Use a unique password of at least 16 characters.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Set this only when the HTTPS public-dashboard profile is approved.
DASHBOARD_DOMAIN=

# Hard risk ceilings. These are ceilings, not targets.
RISK_MAX_PER_TRADE=0.03
RISK_MAX_TOTAL_OPEN=0.10
RISK_MAX_DAILY_LOSS=0.03
RISK_MAX_DRAWDOWN=0.10
RISK_MAX_NOTIONAL_PER_TRADE=0.25

# Conservative minimum stress moves for stop-based positions.
RISK_STOCK_STRESS_MOVE=0.05
RISK_CRYPTO_STRESS_MOVE=0.10
RISK_STOCK_SLIPPAGE_BPS=25
RISK_CRYPTO_SLIPPAGE_BPS=100
RISK_OPTION_SLIPPAGE_PER_PACKAGE=5

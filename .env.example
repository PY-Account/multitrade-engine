# Alpaca Paper only. Live trading is intentionally not supported in this MVP.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# A second switch is required even for Paper order submission.
TRADING_ENABLE_PAPER_ORDERS=false
TRADING_DB_PATH=var/trading.db
TRADING_HEARTBEAT_SECONDS=30
TRADING_HEALTH_PATH=var/health.json
TRADING_HEALTH_MAX_AGE_SECONDS=120

# The dashboard is read-only and is not published to the internet yet.
# Use a unique password of at least 16 characters.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Set this only when the HTTPS public-dashboard profile is approved.
DASHBOARD_DOMAIN=

# Hard risk ceilings. These are ceilings, not targets.
RISK_MAX_PER_TRADE=0.03
RISK_MAX_TOTAL_OPEN=0.10
RISK_MAX_DAILY_LOSS=0.03
RISK_MAX_DRAWDOWN=0.10
RISK_MAX_NOTIONAL_PER_TRADE=0.25

# Conservative minimum stress moves for stop-based positions.
RISK_STOCK_STRESS_MOVE=0.05
RISK_CRYPTO_STRESS_MOVE=0.10
RISK_STOCK_SLIPPAGE_BPS=25
RISK_CRYPTO_SLIPPAGE_BPS=100
RISK_OPTION_SLIPPAGE_PER_PACKAGE=5
